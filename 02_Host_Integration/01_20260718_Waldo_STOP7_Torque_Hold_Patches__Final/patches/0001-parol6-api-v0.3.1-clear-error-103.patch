+"""Regression tests for one-shot firmware system commands."""
+
+from collections import deque
+from types import SimpleNamespace
+
+import numpy as np
+from waldoctl import ActionState
+
+from parol6.commands.system_commands import HaltCommand, ResumeCommand
+from parol6.commands.utility_commands import ResetCommand
+from parol6.protocol.wire import (
+    CheckpointCmd,
+    CommandCode,
+    HaltCmd,
+    ResetCmd,
+    ResumeCmd,
+    pack_tx_frame_into,
+)
+from parol6.server.controller import Controller
+from parol6.server.motion_planner import MotionPlanner
+from parol6.server.segment_player import SegmentPlayer
+from parol6.server.state import ControllerState
+from parol6.server.transports.mock_serial_transport import MockSerialTransport
+from parol6.utils.error_codes import ErrorCode
+
+
+class RecordingTransportManager:
+    def __init__(self, results):
+        self.results = deque(results)
+        self.commands = []
+        self.first_frame_received = True
+
+    def write_frame(
+        self,
+        position_out,
+        speed_out,
+        command_value,
+        affected_joint_out,
+        inout_out,
+        timeout_out,
+        gripper_data_out,
+    ):
+        self.commands.append(command_value)
+        return self.results.popleft()
+
+
+def bare_controller(write_results):
+    controller = Controller.__new__(Controller)
+    controller._transport_mgr = RecordingTransportManager(write_results)
+    controller._firmware_command_queue = deque()
+    return controller
+
+
+def test_clear_error_uses_existing_56_byte_frame_layout():
+    out = bytearray(56)
+    zeros6 = np.zeros(6, dtype=np.int32)
+    zeros8 = np.zeros(8, dtype=np.uint8)
+    gripper = np.zeros(6, dtype=np.int32)
+
+    pack_tx_frame_into(
+        memoryview(out),
+        zeros6,
+        zeros6,
+        CommandCode.CLEAR_ERROR,
+        zeros8,
+        zeros8,
+        0,
+        gripper,
+    )
+
+    assert len(out) == 56
+    assert out[:4] == b"\xff\xff\xff\x34"
+    assert out[40] == 103
+    assert out[41:53] == bytes(12)
+    assert out[53:] == b"\xe4\x01\x02"
+
+
+def test_reset_sequence_arms_clears_and_releases_before_idle():
+    controller = bare_controller([True, True, True, True])
+    state = ControllerState()
+    controller._firmware_command_queue.extend(
+        [CommandCode.IDLE, CommandCode.CLEAR_ERROR, CommandCode.IDLE]
+    )
+
+    for _ in range(4):
+        controller._write_to_firmware(state)
+
+    assert controller._transport_mgr.commands == [255, 103, 255, 255]
+    assert not controller._firmware_command_queue
+
+
+def test_failed_write_retries_without_consuming_one_shot():
+    controller = bare_controller([False, True, True])
+    state = ControllerState()
+    controller._firmware_command_queue.extend(
+        [CommandCode.IDLE, CommandCode.CLEAR_ERROR, CommandCode.IDLE]
+    )
+
+    controller._write_to_firmware(state)
+    assert list(controller._firmware_command_queue) == [
+        CommandCode.IDLE,
+        CommandCode.CLEAR_ERROR,
+        CommandCode.IDLE,
+    ]
+
+    controller._write_to_firmware(state)
+    assert list(controller._firmware_command_queue) == [
+        CommandCode.CLEAR_ERROR,
+        CommandCode.IDLE,
+    ]
+
+    controller._write_to_firmware(state)
+    assert controller._transport_mgr.commands == [255, 255, 103]
+
+
+def test_queue_waits_for_first_telemetry_frame():
+    controller = bare_controller([True, True])
