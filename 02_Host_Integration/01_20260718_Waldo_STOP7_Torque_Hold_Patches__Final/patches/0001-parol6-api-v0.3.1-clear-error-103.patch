+        assert current_generation == old_generation + 1
+
+        late_steps = np.tile(_home_steps(), (2, 1))
+        late_steps[:, 0] += 100
+        planner._segment_queue.put(
+            TrajectorySegment(
+                command_index=41,
+                trajectory_steps=late_steps,
+                duration=0.02,
+                generation=old_generation,
+                command_name="MoveJCommand",
+            )
+        )
+
+        before = state.Position_out.copy()
+        assert player.tick(state) is False
+        np.testing.assert_array_equal(state.Position_out, before)
+        assert state.executing_command_index != 41
+        assert player.active is False
+
+        current_steps = np.tile(_home_steps(), (2, 1))
+        current_steps[:, 0] += 200
+        planner._segment_queue.put(
+            TrajectorySegment(
+                command_index=42,
+                trajectory_steps=current_steps,
+                duration=0.02,
+                generation=current_generation,
+                command_name="MoveJCommand",
+            )
+        )
+
+        assert player.tick(state) is True
+        assert state.executing_command_index == 42
+        np.testing.assert_array_equal(state.Position_out, current_steps[0])
+
