+++ b/tests/test_exp19_reset_handshake_source.py
@@ -0,0 +1,122 @@
+"""Source contracts for the Exp19 real-hardware reset handshake."""
+
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+CONTROL = (ROOT / "waldo_commander" / "components" / "control.py").read_text(
+    encoding="utf-8"
+)
+MAIN = (ROOT / "waldo_commander" / "main.py").read_text(encoding="utf-8")
+
+
+def _function_block(source: str, start: str, end: str) -> str:
+    return source.split(start, 1)[1].split(end, 1)[0]
+
+
+def test_physical_release_keeps_explicit_reset_action_visible() -> None:
+    block = _function_block(
+        CONTROL,
+        "    def check_state_change(self) -> None:",
+        "\n\nclass _ToolQuickActions:",
+    )
+    assert "Awaiting explicit Reset & Resume" in block
+    assert "self.close()" not in block
+
+
+def test_estop_ui_reports_safety_reset_state_without_claiming_button_pressed() -> None:
+    show_block = _function_block(
+        CONTROL,
+        "    def show(self, is_physical: bool) -> None:",
+        "\n\n    def close(self) -> None:",
+    )
+    assert "STOP7 / Safety Reset Required" in show_block
+    assert "remains latched" in show_block
+    assert "Confirm the physical E-STOP is released" in show_block
+    assert "The physical E-STOP button was pressed" not in show_block
+    assert '"Reset & Resume", on_click=reset_and_resume' in show_block
+
+
+def test_first_zero_ack_is_not_logged_as_a_physical_stop_edge() -> None:
+    init_block = _function_block(
+        CONTROL,
+        '    def __init__(self, client: "RobotClient", ui_client_fn: Callable[[], Any]) -> None:',
+        "\n\n    def show(self, is_physical: bool) -> None:",
+    )
+    state_block = _function_block(
+        CONTROL,
+        "    def check_state_change(self) -> None:",
+        "\n\nclass _ToolQuickActions:",
+    )
+    assert "self._last_io_state: int | None = None" in init_block
+    assert "if self._last_io_state is None:" in state_block
+    assert "safety reset required at startup" in state_block
+
+
+def test_digital_stop_resumes_without_resetting_firmware() -> None:
+    show_block = _function_block(
+        CONTROL,
+        "    def show(self, is_physical: bool) -> None:",
+        "\n\n    def close(self) -> None:",
+    )
+    digital_callback = _function_block(
+        show_block,
+        "                async def resume_digital_stop() -> None:",
+        "\n\n                if is_physical:",
+    )
+    assert "await self._client.resume()" in digital_callback
+    assert "_reset_and_verify_hardware_safe" not in digital_callback
+    assert "client.reset" not in digital_callback
+    assert "holding torque remains active" in show_block
+    assert 'ui.button("Resume", on_click=resume_digital_stop)' in show_block
+
+
+def test_reset_helper_waits_for_stop7_latch_ack() -> None:
+    block = _function_block(
+        CONTROL,
+        'async def _reset_and_verify_hardware_safe(client: "RobotClient") -> bool:',
+        "\n\n@dataclasses.dataclass",
+    )
+    assert "await asyncio.sleep(0.06)" in block
+    assert "await client.reset()" in block
+    assert "io_state[4] == 1" in block
+    assert "return False" in block
+
+
+def test_real_hardware_startup_never_auto_resumes() -> None:
+    initial_mode = _function_block(
+        MAIN,
+        "    async def _set_initial_mode(port: str) -> None:",
+        "\n\n    async def _restore_settings()",
+    )
+    hardware_branch = initial_mode.split("        else:", 1)[1]
+    assert "await client.halt()" in hardware_branch
+    assert "await client.resume()" not in hardware_branch
+
+    page_init = _function_block(
+        MAIN,
+        "            async def _init():",
+        "\n\n            ui.timer(",
+    )
+    hardware_switch = page_init.split(
+        "if hw_now and waldoctl.commander.status.simulator_active:", 1
+    )[1]
+    assert "await client.halt()" in hardware_switch
+    assert "await client.resume()" not in hardware_switch
+
+
+def test_manual_simulator_to_hardware_never_auto_resumes() -> None:
+    toggle = _function_block(
+        CONTROL,
+        "    async def on_toggle_sim(self) -> None:",
+        "\n\n    async def on_estop_click(self) -> None:",
+    )
+    hardware_switch = toggle.split(
+        "            else:\n"
+        "                await self.client.simulator(False)",
+        1,
+    )[1]
+    assert "await self.client.halt()" in hardware_switch
+    assert "self.estop.show(is_physical=False)" in hardware_switch
+    assert "_reset_and_verify_hardware_safe" not in hardware_switch
+    assert "await self.client.resume()" not in hardware_switch
