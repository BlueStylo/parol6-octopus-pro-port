+async def _reset_and_verify_hardware_safe(client: "RobotClient") -> bool:
+    """Send one reset edge and wait for Exp19's STOP7 latch acknowledgement."""
+    # STOP7 must be closed continuously for the firmware's 50 ms guard.
+    await asyncio.sleep(0.06)
+    await client.reset()
+
+    # Exp19 maps io[4] to STOP7 closed AND both BootResetRequired/EstopOpen
+    # clear, so a high value acknowledges the accepted CLEAR_ERROR(103) edge.
+    await asyncio.sleep(0.10)
+    for _ in range(20):
+        io_state = await client.io()
+        if io_state and len(io_state) > 4 and io_state[4] == 1:
+            return True
+        await asyncio.sleep(0.05)
+    return False
+
