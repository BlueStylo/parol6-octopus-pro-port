{
  "build": {
    "core": "stm32",
    "cpu": "cortex-m4",
    "extra_flags": "-DSTM32F4 -DSTM32F446xx -DSTM32F4xx",
    "f_cpu": "180000000L",
    "flash_offset": "0x8000",
    "mcu": "stm32f446zet6",
    "product_line": "STM32F446xx",
    "variant": "STM32F4xx/F446Z(C-E)(H-J-T)"
  },
  "connectivity": [
    "can"
  ],
  "debug": {
    "jlink_device": "STM32F446ZE",
    "openocd_target": "stm32f4x",
    "svd_path": "STM32F446x.svd"
  },
  "frameworks": [
    "arduino",
    "cmsis",
    "stm32cube",
    "libopencm3"
  ],
  "name": "BTT Octopus Pro V1.0 F446 PAROL6 literal upstream port",
  "upload": {
    "maximum_ram_size": 131072,
    "maximum_size": 524288,
    "offset_address": "0x08008000",
    "protocol": "stlink",
    "protocols": [
      "blackmagic",
      "dfu",
      "jlink",
      "serial",
      "stlink"
    ]
  },
  "url": "https://github.com/bigtreetech/BIGTREETECH-OCTOPUS-Pro",
  "vendor": "PAROL6 Octopus Pro Exp22"
}
